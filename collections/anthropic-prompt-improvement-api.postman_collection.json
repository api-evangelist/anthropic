  "item": [
    {
      "id": "e7eaf7a6-f69e-4258-8813-a0f915a43f1e",
      "name": "Prompt Improvement",
      "description": {
        "content": "APIs for enhancing existing prompts with feedback",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "5a56ff51-17e9-46c8-b0a0-1e8d9b088e1c",
          "name": "Anthropic Improve A Prompt",
          "request": {
            "name": "Anthropic Improve A Prompt",
            "description": {
              "content": "Create a new-and-improved prompt guided by feedback. This API takes an\nexisting prompt and enhances it based on provided feedback or general\nprompt engineering best practices.\n\n**Requirements:**\n- Must have joined the closed research preview for prompt tools APIs\n- Must use the API directly (not available in SDK)\n- Must include the beta header `prompt-tools-2025-04-02`\n- Messages must contain only text-only content blocks\n- No tool calls, images, or prompt caching blocks allowed\n- Only contiguous user messages with text content are permitted\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "experimental",
                "improve_prompt"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "Optional header to specify the beta version(s) you want to use.\nTo use multiple betas, use a comma separated list like `beta1,beta2`\nor specify the header multiple times for each beta.\n",
                "key": "anthropic-beta",
                "value": "<string>,<string>"
              },
              {
                "disabled": false,
                "description": "(Required) A valid API token.",
                "key": "x-api-key",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Enable CORS.",
                "key": "anthropic-dangerous-direct-browser-access",
                "value": "true"
              },
              {
                "disabled": false,
                "description": "(Required) Which version of the Anthropic API to use.",
                "key": "anthropic-version",
                "value": "2023-06-01"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    {\n      \"role\": \"<string>\",\n      \"content\": [\n        {\n          \"type\": \"<string>\",\n          \"text\": \"<string>\"\n        },\n        {\n          \"type\": \"<string>\",\n          \"text\": \"<string>\"\n        }\n      ]\n    },\n    {\n      \"role\": \"<string>\",\n      \"content\": [\n        {\n          \"type\": \"<string>\",\n          \"text\": \"<string>\"\n        },\n        {\n          \"type\": \"<string>\",\n          \"text\": \"<string>\"\n        }\n      ]\n    }\n  ],\n  \"feedback\": \"<string>\",\n  \"system\": \"<string>\",\n  \"target_model\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
