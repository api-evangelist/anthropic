{
  "item": [
    {
      "id": "011cb83a-f441-498d-a033-0dfd1af8333f",
      "name": "Prompt Templatization",
      "description": {
        "content": "APIs for converting prompts into reusable templates with variables",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "1f740f21-bcc3-48dd-948b-841e8e73c7de",
          "name": "Anthropic Templatize A Prompt",
          "request": {
            "name": "Anthropic Templatize A Prompt",
            "description": {
              "content": "Templatize a prompt by identifying and extracting variables. This API\nanalyzes a prompt and converts specific values into reusable template\nvariables with placeholders.\n\n**Requirements:**\n- Must have joined the closed research preview for prompt tools APIs\n- Must use the API directly (not available in SDK)\n- Must include the beta header `prompt-tools-2025-04-02`\n- Messages must contain only text-only content blocks\n- No tool calls, images, or prompt caching blocks allowed\n- Only contiguous user messages with text content are permitted\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "experimental",
                "templatize_prompt"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "Optional header to specify the beta version(s) you want to use.\nTo use multiple betas, use a comma separated list like `beta1,beta2`\nor specify the header multiple times for each beta.\n",
                "key": "anthropic-beta",
                "value": "<string>,<string>"
              },
              {
                "disabled": false,
                "description": "(Required) A valid API token.",
                "key": "x-api-key",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Enable CORS.",
                "key": "anthropic-dangerous-direct-browser-access",
                "value": "true"
              },
              {
                "disabled": false,
                "description": "(Required) Which version of the Anthropic API to use.",
                "key": "anthropic-version",
                "value": "2023-06-01"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    {\n      \"role\": \"<string>\",\n      \"content\": [\n        {\n          \"type\": \"<string>\",\n          \"text\": \"<string>\"\n        },\n        {\n          \"type\": \"<string>\",\n          \"text\": \"<string>\"\n        }\n      ]\n    },\n    {\n      \"role\": \"<string>\",\n      \"content\": [\n        {\n          \"type\": \"<string>\",\n          \"text\": \"<string>\"\n        },\n        {\n          \"type\": \"<string>\",\n          \"text\": \"<string>\"\n        }\n      ]\n    }\n  ],\n  \"system\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "e9f81380-6959-4968-8d9b-5e3693bf7bc4",
              "name": "Successful Response",
              "originalRequest": {
                "url": {
                  "path": [
                    "v1",
                    "experimental",
                    "templatize_prompt"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "x-api-key",
                    "value": "<API Key>"
                  },
                  {
                    "disabled": false,
                    "description": "Optional header to specify the beta version(s) you want to use.\nTo use multiple betas, use a comma separated list like `beta1,beta2`\nor specify the header multiple times for each beta.\n",
                    "key": "anthropic-beta",
                    "value": "prompt-tools-2025-04-02"
                  },
                  {
                    "disabled": false,
                    "description": "(Required) A valid API token.",
                    "key": "x-api-key",
                    "value": "<string>"
                  },
                  {
                    "disabled": false,
                    "description": "(Required) The content type.",
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "disabled": false,
                    "description": "Enable CORS.",
                    "key": "anthropic-dangerous-direct-browser-access",
                    "value": "true"
                  },
                  {
                    "disabled": false,
                    "description": "(Required) Which version of the Anthropic API to use.",
                    "key": "anthropic-version",
                    "value": "2023-06-01"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": [\n        {\n          \"type\": \"text\",\n          \"text\": \"Translate hello to German\"\n        }\n      ]\n    }\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": [\n        {\n          \"type\": \"text\",\n          \"text\": \"Translate {{WORD_TO_TRANSLATE}} to {{TARGET_LANGUAGE}}\"\n        }\n      ]\n    }\n  ],\n  \"system\": \"You are a professional English to {{TARGET_LANGUAGE}} translator\",\n  \"usage\": {\n    \"input_tokens\": 15,\n    \"output_tokens\": 25\n  },\n  \"variable_values\": {\n    \"WORD_TO_TRANSLATE\": \"hello\",\n    \"TARGET_LANGUAGE\": \"German\"\n  }\n}",
              "cookie": [],
