          "name": "Anthropic Count Tokens In A Message",
          "request": {
            "name": "Anthropic Count Tokens In A Message",
            "description": {
              "content": "Count the number of tokens in a message before sending it.\nThis allows you to make informed decisions about message length\nand manage your token budget effectively.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "messages",
                "count_tokens"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) The version of the Anthropic API you want to use. Read more about\nversioning and our version history here.\n",
                "key": "anthropic-version",
                "value": "2023-06-01"
              },
              {
                "disabled": false,
                "description": "Optional header to specify the beta version(s) you want to use. To\nuse multiple betas, use a comma separated list like beta1,beta2 or\nspecify the header multiple times for each beta.\n",
