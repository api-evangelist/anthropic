{
  "opencollection": "1.0.0",
  "info": {
    "name": "Anthropic Admin Agents Tokens API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Anthropic Count Tokens In A Message",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.anthropic.com/v1/v1/messages/count_tokens",
            "headers": [
              {
                "name": "anthropic-version",
                "value": ""
              },
              {
                "name": "anthropic-beta",
                "value": ""
              },
              {
                "name": "x-api-key",
                "value": ""
              },
              {
                "name": "Content-Type",
                "value": ""
              },
              {
                "name": "anthropic-dangerous-direct-browser-access",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Count the number of tokens in a message before sending it.\nThis allows you to make informed decisions about message length\nand manage your token budget effectively.\n"
        }
      ]
    }
  ],
  "bundled": true
}