{
  "opencollection": "1.0.0",
  "info": {
    "name": "Anthropic Admin Agents Organization API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Organization",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Anthropic Get Current Organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.anthropic.com/v1/organizations/me",
            "headers": [
              {
                "name": "anthropic-version",
                "value": ""
              }
            ]
          },
          "docs": "Retrieves information about the current authenticated user's organization."
        }
      ]
    }
  ],
  "bundled": true
}