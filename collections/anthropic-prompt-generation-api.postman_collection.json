  "item": [
    {
      "id": "76fdde88-0925-4a35-898c-7cd86efbdfb8",
      "name": "Prompt Generation",
      "description": {
        "content": "APIs for generating well-written prompts for specified tasks",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "43089025-5116-4282-a8bf-bbccc82f8509",
          "name": "Anthropic Generate A Prompt",
          "request": {
            "name": "Anthropic Generate A Prompt",
            "description": {
              "content": "Generate a well-written prompt for a specified task. This API creates\nprompts that can be used directly with the Messages API.\n\n**Requirements:**\n- Must have joined the closed research preview for prompt tools APIs\n- Must use the API directly (not available in SDK)\n- Must include the beta header `prompt-tools-2025-04-02`\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "experimental",
                "generate_prompt"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "Optional header to specify the beta version(s) you want to use.\nTo use multiple betas, use a comma separated list like `beta1,beta2`\nor specify the header multiple times for each beta.\n",
                "key": "anthropic-beta",
                "value": "<string>,<string>"
              },
              {
                "disabled": false,
                "description": "(Required) A valid API token.",
                "key": "x-api-key",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Enable CORS.",
                "key": "anthropic-dangerous-direct-browser-access",
                "value": "true"
              },
              {
                "disabled": false,
                "description": "(Required) Which version of the Anthropic API to use.",
                "key": "anthropic-version",
                "value": "2023-06-01"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task\": \"<string>\",\n  \"target_model\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "c6feada8-0e98-4cfc-90ba-26e7e692b307",
              "name": "Successful Response",
              "originalRequest": {
                "url": {
                  "path": [
                    "v1",
                    "experimental",
                    "generate_prompt"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
