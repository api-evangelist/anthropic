                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "x-api-key",
                    "value": "<API Key>"
                  },
                  {
                    "disabled": false,
                    "description": "Optional header to specify the beta version(s) you want to use.\nTo use multiple betas, use a comma separated list like `beta1,beta2`\nor specify the header multiple times for each beta.\n",
                    "key": "anthropic-beta",
                    "value": "prompt-tools-2025-04-02"
                  },
                  {
                    "disabled": false,
                    "description": "(Required) A valid API token.",
                    "key": "x-api-key",
                    "value": "<string>"
                  },
                  {
                    "disabled": false,
                    "description": "(Required) The content type.",
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "disabled": false,
                    "description": "Enable CORS.",
                    "key": "anthropic-dangerous-direct-browser-access",
                    "value": "true"
                  },
                  {
                    "disabled": false,
                    "description": "(Required) Which version of the Anthropic API to use.",
                    "key": "anthropic-version",
                    "value": "2023-06-01"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"task\": \"a chef for a meal prep planning service\",\n  \"target_model\": \"claude-3-7-sonnet-20250219\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": [\n        {\n          \"type\": \"text\",\n          \"text\": \"You are a chef for a meal prep planning service. Your role is to help users plan their weekly meals, create shopping lists, and provide cooking instructions. Always consider dietary restrictions and preferences when making suggestions.\"\n        }\n      ]\n    },\n    {\n      \"role\": \"assistant\",\n      \"content\": [\n        {\n          \"type\": \"text\",\n          \"text\": \"<recipe_planning>\"\n        }\n      ]\n    }\n  ],\n  \"system\": \"\",\n  \"usage\": {\n    \"input_tokens\": 25,\n    \"output_tokens\": 150\n  }\n}",
              "cookie": [],
